        <script><![CDATA[(function () {
    var today = new GlideDateTime();
    var gr = new GlideRecord('x_1919710_refurt_0_compliance_record');
    gr.addQuery('expiry_date', '<', today);
    gr.addQuery('compliance_status', '!=', 'expired');
    gr.query();

    var count = 0;
    while (gr.next()) {
        gr.setValue('compliance_status', 'expired');
        gr.update();
        count++;
    }
    gs.info('ComplianceExpiryChecker: Updated ' + count + ' records to expired status');
})();
