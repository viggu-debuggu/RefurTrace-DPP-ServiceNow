        <rest_service_text/>
        <rest_variables/>
        <role_conditions/>
        <script><![CDATA[(function executeRule(current, previous) {
    var newStatus = current.getValue('compliance_status');
    var oldStatus = previous.getValue('compliance_status');

    // Only gate when compliance_status is being changed TO 'verified'
    if (newStatus === 'verified' && newStatus !== oldStatus) {
        if (!gs.hasRole('x_1919710_refurt_0.compliance_officer') && !gs.hasRole('admin')) {
            gs.addErrorMessage(
                "Only a Compliance Officer can set status to 'verified'. Please submit for review."
            );
            current.setAbortAction(true);
        }
    }
})(current, previous);
]]></script>
