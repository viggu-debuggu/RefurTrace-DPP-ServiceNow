        <value>(function(outputs, steps, params, stepResult, assertEqual) {
    var today = new GlideDateTime();
    var gr = new GlideRecord('x_1919710_refurt_0_compliance_record');
    gr.addQuery('expiry_date', '&lt;', today);
    gr.addQuery('compliance_status', '!=', 'expired');
    gr.query();
    var count = 0;
    while (gr.next()) {
        gr.setValue('compliance_status', 'expired');
        gr.update();
        count++;
    }
    stepResult.setOutputMessage('Compliance expiry checker updated ' + count + ' record(s) to expired');
})(outputs, steps, params, stepResult, assertEqual);</value>
