        <value>(function(outputs, steps, params, stepResult, assertEqual) {
                var handler = new GDPRErasureHandler();

                var requestId = handler.register('nonexistent_user_' + gs.generateGUID());

                // Anonymise (nothing to anonymise, but should not error)
                handler.anonymise(requestId);

                // Verify — should confirm clean
                var verification = handler.verify(requestId);
                assertEqual({ name: 'verify must return an object', shouldbe: true, value: typeof verification === 'object' });
                assertEqual({ name: 'verified must be true', shouldbe: true, value: verification.verified === true });

                // Audit — should not error
                handler.audit(requestId);

                stepResult.setOutputMessage(
                    'verified=' + verification.verified +
                    ' | remainingRecords=' + verification.remainingRecords
                );
            })(outputs, steps, params, stepResult, assertEqual);</value>
