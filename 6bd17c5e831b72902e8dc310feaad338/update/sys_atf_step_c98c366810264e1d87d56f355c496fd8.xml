        <value>(function(outputs, steps, params, stepResult, assertEqual) {
                var KNOWN_CODE = '654321';
                // Find the record inserted by step 1
                var gr = new GlideRecord('x_1919710_refurt_0_service_log');
                gr.addQuery('technician_name', 'ATF Valid OTP Test');
                gr.orderByDesc('sys_created_on');
                gr.setLimit(1);
                gr.query();
                if (gr.next()) {
                    gr.setValue('otp_code', KNOWN_CODE);
                    gr.setWorkflow(false);
                    gr.update();
                    stepResult.setOutputMessage('Stored OTP code ' + KNOWN_CODE + ' on record ' + gr.getUniqueValue());
